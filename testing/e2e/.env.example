# Copy to .env.local (gitignored). Never commit real tokens.
#
# Option A — fastest (paste JWT after logging in once: DevTools → Application → localStorage → access_token)
E2E_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
E2E_REFRESH_TOKEN=
E2E_PHONE=9876543210

# Option B — manual OTP (paste latest 6-digit code right before running)
# E2E_PHONE=9876543210
# E2E_OTP=123456

# Option C — DB + API (no OTP UI): send-otp → read otp_verifications → verify-otp → JWT in .env.local
#   npm run test:e2e:auth-db        # writes E2E_ACCESS_TOKEN (+ refresh)
#   npm run test:e2e:auth-db:run    # same, then full Playwright suite
# E2E_DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DBNAME   # optional; else ../genda_phool_backend/.env DB_*
