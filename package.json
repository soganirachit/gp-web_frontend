{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-app-links.mjs && tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:generate": "node testing/scripts/generate-artifacts.mjs",
    "test:api-smoke": "node testing/scripts/api-smoke.mjs",
    "test:api-auth-smoke": "node testing/scripts/api-authenticated-smoke.mjs",
    "test:static-smoke": "node testing/scripts/static-smoke.mjs",
    "test:e2e": "playwright test --config=testing/e2e/playwright.config.mjs",
    "test:e2e:auth-db": "node testing/scripts/e2e-auth-via-db.mjs",
    "test:e2e:auth-db:run": "node testing/scripts/e2e-auth-via-db.mjs --e2e",
    "test:gp-plan": "node testing/scripts/run-full-plan.mjs",
    "test:gp-plan:full": "npm run test:e2e:auth-db && npm run test:gp-plan",
    "test:gp-plan:no-e2e": "SKIP_PLAYWRIGHT=1 node testing/scripts/run-full-plan.mjs"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.6",
    "@reduxjs/toolkit": "^2.2.1",
    "@sentry/react": "^8.0.0",
    "@types/react-datepicker": "^6.2.0",
    "axios": "^1.6.7",
    "chart.js": "^4.4.8",
    "date-fns": "^4.1.0",
    "firebase": "^10.8.0",
    "framer-motion": "^11.0.8",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-datepicker": "^8.2.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.50.1",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.1",
    "react-slick": "^0.30.3",
    "slick-carousel": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/react-slick": "^0.23.13",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^13.24.0",
    "pg": "^8.20.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.3"
  }
}
