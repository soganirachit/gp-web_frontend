# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Google Maps API Key (get from Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API base URL
#
# Production / direct API (browser needs CORS from the API for your site):
# VITE_API_BASE_URL=https://your-api-domain.com/api/v1
#
# Local dev (recommended): same-origin + Vite proxy — also add VITE_DEV_PROXY_TARGET and restart `npm run dev`.
# VITE_API_BASE_URL=/api/v1
# VITE_DEV_PROXY_TARGET=https://your-api-domain.com
#
VITE_API_BASE_URL=https://your-api-domain.com/api/v1

# Referral share links (optional; defaults to production site)
VITE_REFERRAL_SITE_URL=https://mygendaphool.com

# Feature flags
VITE_GP_DAILY_ENABLED=false

# Sentry DSN for error tracking (get from sentry.io)
VITE_SENTRY_DSN=
